#!/usr/bin/env bash
# Stub secret-tool for tests.
# Behavior:
#   lookup service S profile P token T  -> prints ${STUB_SECRET_VALUE:-}
#                                          exits 1 when STUB_SECRET_MISSING=1
#   store ...                           -> records stdin+attrs to $STUB_STORE_LOG
set -euo pipefail
cmd="${1:-}"
if [ "$cmd" = "lookup" ]; then
    if [ "${STUB_SECRET_MISSING:-0}" = "1" ]; then
        exit 1
    fi
    printf "%s" "${STUB_SECRET_VALUE:-stub-secret}"
elif [ "$cmd" = "store" ]; then
    val=$(cat)
    if [ -n "${STUB_STORE_LOG:-}" ]; then
        printf "store %s | %s\n" "$*" "$val" >> "$STUB_STORE_LOG"
    fi
else
    exit 2
fi
