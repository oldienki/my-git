#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$SCRIPT_DIR/my-git-core.inc.sh" ]; then
    echo "Error: shared library 'my-git-core.inc.sh' not found next to $(basename "$0")" >&2
    exit 1
fi
# shellcheck source=my-git-core.inc.sh
. "$SCRIPT_DIR/my-git-core.inc.sh"

PROFILES_DIR="$MY_GIT_PROFILES_DIR"

usage() {
    cat <<EOF
Usage: $(basename "$0") [twine_options...] [dist_files...]

Publishes a Python package to PyPI using the token associated with the current Git repository's email.

How it works:
  1. Reads 'user.email' from the current Git repository configuration.
  2. Finds the corresponding profile in $PROFILES_DIR matching that email.
  3. Extracts 'pypi_token' from the profile.
  4. Runs 'twine upload' using the token as password (__token__ as username).
  5. If no files or arguments are specified, defaults to 'dist/*'.

Examples:
  $(basename "$0")
  $(basename "$0") dist/*.whl
  $(basename "$0") --repository testpypi dist/*
EOF
    exit 1
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
fi

# 1. Verify twine is installed
if ! command -v twine >/dev/null 2>&1; then
    echo "Error: 'twine' executable not found in PATH. Install it via 'pip install twine'." >&2
    exit 1
fi

# 2. Verify current directory is inside a Git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: Current directory is not a Git repository" >&2
    exit 1
fi

# 3. Retrieve user.email from the repository
REPO_EMAIL=$(git config user.email 2>/dev/null || true)
if [ -z "$REPO_EMAIL" ]; then
    echo "Error: 'user.email' is not configured in this repository" >&2
    exit 1
fi

if [ ! -d "$PROFILES_DIR" ]; then
    echo "Error: Profiles directory not found at $PROFILES_DIR" >&2
    exit 1
fi

# 4. Search profiles for a matching email
MATCHED_PROFILE=""
PYPI_TOKEN=""

if MATCHED_PROFILE=$(find_profile_by_email "$REPO_EMAIL") && [ -n "$MATCHED_PROFILE" ]; then
    PYPI_TOKEN=$(resolve_token "$(parse_field "$PROFILES_DIR/$MATCHED_PROFILE" "pypi_token")")
fi

if [ -z "$MATCHED_PROFILE" ]; then
    echo "Error: No profile found matching repository email '$REPO_EMAIL' in $PROFILES_DIR" >&2
    exit 1
fi

if [ -z "$PYPI_TOKEN" ]; then
    echo "Error: 'pypi_token' is not defined or is empty in profile '$MATCHED_PROFILE'" >&2
    exit 1
fi

# 5. Determine upload targets
UPLOAD_ARGS=()
if [ "$#" -eq 0 ]; then
    if [ ! -d "dist" ] || [ -z "$(ls -A dist 2>/dev/null)" ]; then
        echo "Error: Directory 'dist/' is missing or empty. Build your package first (e.g., 'python -m build')." >&2
        exit 1
    fi
    UPLOAD_ARGS=("dist/*")
else
    UPLOAD_ARGS=("$@")
fi

echo "==> Publishing package to PyPI using profile '$MATCHED_PROFILE' ($REPO_EMAIL)..."

# 6. Execute twine upload with isolated credentials
TWINE_USERNAME="__token__" \
TWINE_PASSWORD="$PYPI_TOKEN" \
twine upload --non-interactive "${UPLOAD_ARGS[@]}"
